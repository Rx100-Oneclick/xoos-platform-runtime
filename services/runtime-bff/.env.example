# XO token verification
XO_AUTH_JWKS_URL=https://<xo-auth-project>.supabase.co/functions/v1/jwks
XO_AUTH_ISSUER=https://<your-xo-auth-issuer>
XO_AUTH_AUDIENCE=xo-api
# Base URL for XO Auth protected resource Edge Functions
XO_AUTH_FUNCTIONS_BASE_URL=https://bolngokjtpjomleifuto.supabase.co/functions/v1

# XO Auth Runtime control-plane Supabase project - backend only
SUPABASE_URL=https://<xo-auth-project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<server-only>

# Services authorization Supabase project - backend only.
# Never expose this key to @xoos/runtime, @xoos/microapp-adapter, or Microapps.
SERVICES_URL=https://<services-project>.supabase.co
SERVICES_SECRET_KEY=sb_secret_<server-only>

# Runtime behavior
XOOS_RUNTIME_VERSION=1.2.0
XOOS_MINIMUM_RUNTIME_VERSION=1.0.0
XOOS_MICROAPP_SIGNED_URL_TTL_SECONDS=300
# In-isolate optimization only. Live XO session/application access is revalidated per request.
XOOS_AUTHORIZATION_SNAPSHOT_TTL_SECONDS=45

# XOOS data-token signing.
# Store the private JWK only in backend/Edge Function secrets, never in browser code.
XOOS_DATA_JWT_PRIVATE_JWK={"kty":"EC","crv":"P-256","kid":"<kid>","x":"<x>","y":"<y>","d":"<private-d>","alg":"ES256"}
XOOS_DATA_JWT_ISSUER=xoos-data
XOOS_DATA_JWT_AUDIENCE=authenticated
XOOS_DATA_JWT_TTL_SECONDS=600

# Allowed browser origins are NOT configured here.
# They are resolved dynamically from public.oauth_allowed_origins by client_id.
# Runtime environment and application binding are resolved from public.oauth_clients.
