# XO token verification
XO_AUTH_JWKS_URL=https://YOUR-XO-AUTH-DOMAIN/functions/v1/jwks
XO_AUTH_ISSUER=https://YOUR-XO-AUTH-ISSUER
XO_AUTH_AUDIENCE=xo-api

# Registry project - backend only
SUPABASE_URL=https://bolngokjtpjomleifuto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Runtime behavior
XOOS_RUNTIME_VERSION=0.1.0
XOOS_MINIMUM_RUNTIME_VERSION=0.1.0

# Allowed browser origins are NOT configured here.
# They are resolved dynamically from public.oauth_allowed_origins by client_id.
# Runtime environment is resolved from public.oauth_clients.environment.
